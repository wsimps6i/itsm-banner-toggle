{
  "manifest_version": 3,
  "name": "ITSM Banner Toggle",
  "version": "1.3.1",
  "description": "Show or hide the announcement banners on ServiceNow ITSM sites.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-banners": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Hide or show the banners"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ITSM Banner Toggle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
